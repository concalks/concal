{
  "name": "office-addin-taskpane",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "author": "JW",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "web",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/msal-node": "^7.1.0",
    "@tootallnate/once": "^3.0.1",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "core-js": "^3.36.0",
    "jsonwebtoken": "^9.0.3",
    "regenerator-runtime": "^0.14.1",
    "tar": "^7.5.22",
    "uuid": "^14.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/office-js": "^1.0.609",
    "@types/office-runtime": "^1.0.40",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^3.0.0",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-lint": "^4.0.0",
    "office-addin-manifest": "^3.0.0",
    "office-addin-prettier-config": "^3.0.0",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ],
  "allowScripts": {
    "@azure/msal-node-extensions@1.5.32": true,
    "@microsoft/m365agentstoolkit-cli@1.1.17": true,
    "core-js@3.50.0": true,
    "keytar@7.9.0": true,
    "@microsoft/teamsfx-cli@1.1.5": true
  }
}
