<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>692581d3-52df-423a-b357-48592fcee49d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>concalks</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Concal"/>
  <Description DefaultValue="Ein Add-In, um Kontaktdetails direkt mit Terminen zu speichern."/>
  <IconUrl DefaultValue="https://concalks.github.io/concal/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://concalks.github.io/concal/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/concalks/concal"/>
  <AppDomains>
    <AppDomain>gihub.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://concalks.github.io/concal/taskpane_appointment_creation.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="tab_cal">
              <Group id="grp_cal">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="ActionButtonCal">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="CreateAppointmentTaskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://concalks.github.io/concal/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://concalks.github.io/concal/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://concalks.github.io/concal/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://concalks.github.io/concal/commands.html"/>
        <bt:Url id="CreateAppointmentTaskpane.Url" DefaultValue="https://concalks.github.io/concal/taskpane_appointment_creation.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Concal"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Exportiere Kontakt-Details"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Öffnet die Seitenleiste für weitere Kontakt-Details."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
